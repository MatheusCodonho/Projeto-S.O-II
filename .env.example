# Ambiente
NODE_ENV=development
PORT=3000

# Segurança
JWT_SECRET=troque-por-uma-chave-forte-aleatoria
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

# Banco de dados
# Desenvolvimento: arquivo JSON local
DATABASE_URL=sqlite:./data/app.db

# Produção (Neon PostgreSQL): postgresql://user:password@host/database?sslmode=require
# Exemplo: postgresql://usuario:senha@ep-cool-name-123456.us-east-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://...

# MFA
MFA_ISSUER=GestaoProjetosSeguro

# CORS (produção)
# CORS_ORIGIN=https://seu-projeto.vercel.app