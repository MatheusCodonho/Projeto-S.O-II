{
  "name": "sistema-gestao-projetos-seguro",
  "version": "1.0.0",
  "description": "Sistema Seguro de Gestão de Projetos em Ambiente de Nuvem - Segurança por Design",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "forceExit": true,
    "clearMocks": true
  },
  "keywords": [
    "seguranca",
    "nuvem",
    "clean-architecture",
    "crud"
  ],
  "author": "Equipe de Engenharia de Software",
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
